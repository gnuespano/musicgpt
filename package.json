{
  "name": "musicgpt-clone",
  "version": "1.0.0",
  "description": "Clone funcional do MusicGPT: estudio pessoal de criacao musical com IA (letra, voz, instrumentais, playlists, biblioteca, export).",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "npm run test:referencia && npm run test:estilo && npm run test:estilo-varinha && npm run test:varinha && npm run test:letra && npm run test:tema && npm run test:deepseek && npm run test:modo && npm run test:espectro && npm run test:download",
    "test:referencia": "node scripts/testar-audio-referencia.mjs",
    "test:estilo": "node scripts/testar-estilo-prioridade.mjs",
    "test:estilo-varinha": "node scripts/testar-estilo-sophisticated.mjs",
    "test:varinha": "node scripts/testar-varinha.mjs",
    "test:letra": "node scripts/testar-letra-tema.mjs",
    "test:tema": "node scripts/testar-tema-natural.mjs",
    "test:deepseek": "node scripts/testar-deepseek.mjs",
    "test:modo": "node scripts/testar-modo-audio.mjs",
    "test:fidelidade": "node scripts/testar-fidelidade.mjs",
    "test:espectro": "node scripts/testar-espectro.mjs",
    "test:download": "node scripts/testar-download.mjs",
    "cert": "node scripts/gerar-certificado.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@audio/decode-mp3": "^1.3.1",
    "@breezystack/lamejs": "^1.2.7",
    "dotenv": "^18.0.8",
    "multer": "^2.4.0",
    "openai": "^7.39.0",
    "selfsigned": "^5.5.0"
  },
  "license": "MIT",
  "private": true
}
